   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 데이터 준비\n",
    "x = [1, 2, 3, 4, 5]\n",
    "y = [2, 3, 5, 7, 11]\n",
    "\n",
    "# 한글 글꼴(내컴퓨터 > System > fonts)\n",
    "plt.rc('font', family='Malgun Gothic')\n",
    "\n",
    "# 선 그래프\n",
    "plt.plot(x, y, label='Prime numbers')\n",
    "plt.title('선 그래프')\n",
    "plt.legend() #범례\n",
    "# 출력\n",
    "plt.show()"
   ]
